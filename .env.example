# LLM Configuration for the LLMJudge artifact
#
# Supported providers: anthropic, openai, gemini, azure
#
# Configuration priority:
# 1. System environment variables
# 2. This .env file
# 3. Default values

# Provider: anthropic, openai, gemini, or azure
LLM_PROVIDER=anthropic

# Model name (provider-specific)
# Anthropic: claude-sonnet-4-20250514, claude-opus-4-20250514, claude-haiku-3-5-20240307
# OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# Gemini: gemini-1.5-pro, gemini-1.5-flash
# Azure: (not needed - uses deployment name instead)
LLM_MODEL=claude-sonnet-4-5-20250929

# API key - set one of these based on your provider
# LLM_API_KEY=your-api-key-here

# Or use provider-specific keys:
# ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
# GOOGLE_API_KEY=your-google-key

# Azure OpenAI configuration (required when LLM_PROVIDER=azure)
# AZURE_OPENAI_API_KEY=your-azure-api-key
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-02-01

JUDGE_TEMPERATURE=0
SKILL_TEMPERATURE=0